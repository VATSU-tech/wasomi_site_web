# ============================================================================
# Wasomi — variables d'environnement du déploiement Docker
# ============================================================================
# Copiez ce fichier puis adaptez les valeurs :
#
#   cp .env.example .env
#
# ⚠️  NE VERSIONNEZ JAMAIS .env  (il est déjà dans .gitignore)
# ⚠️  Les secrets doivent être générés, jamais écrits à la main.
#
# Générer les 3 secrets JWT (openssl rand -hex 32) :
#   openssl rand -hex 32
# ============================================================================

# ---------------------------------------------------------------------------
# DOMAINE
# ---------------------------------------------------------------------------
# Adresse publique du site.
#   Production : wasomi.cd              -> HTTPS automatique (Let's Encrypt)
#   Local      : http://localhost        -> HTTP simple, aucun certificat
#
# N'INDIQUEZ PAS le port ici : Caddy écoute toujours sur 80 dans le
# conteneur, et c'est le mapping HTTP_PORT ci-dessous qui décide du port
# exposé sur l'hôte.
# Le préfixe "http://" désactive l'auto-HTTPS de Caddy, pour tester en local
# sans certificat.
DOMAIN=http://localhost

# Ports publiés sur l'hôte.
#   8080/8443 : valeurs sûres en local (évite les conflits sur 80/443).
#   80/443    : à utiliser en production.
HTTP_PORT=8080
HTTPS_PORT=8443

# Adresse de contact Let's Encrypt (recommandé en production).
ACME_EMAIL=admin@wasomi.cd

# Fuseau horaire (MySQL + logs).
TZ=Africa/Kinshasa

# ---------------------------------------------------------------------------
# FRONTEND
# ---------------------------------------------------------------------------
# ⚠️  URL ABSOLUE OBLIGATOIRE.
# src/config/env.ts valide avec zod : z.string().url().
# Une valeur relative ("/api/v1") fait ÉCHOUER le build.
#
# Doit correspondre à l'URL vue PAR LE NAVIGATEUR : schéma + hôte + HTTP_PORT.
#   Local      : http://localhost:8080/api/v1
#   Production : https://wasomi.cd/api/v1
#
# En production, ce doit être le domaine public + le préfixe de l'API, afin
# que le navigateur ne voie qu'une seule origine (=> cookies httpOnly OK,
# pas de CORS, pas de SameSite=None).
VITE_API_BASE_URL=http://localhost:8080/api/v1

# URL de l'API « school » si elle est distincte (laisser vide sinon).
VITE_SCHOOL_API_BASE_URL=

VITE_APP_NAME=Wasomi
VITE_API_TIMEOUT_MS=15000

# ---------------------------------------------------------------------------
# BASE DE DONNÉES
# ---------------------------------------------------------------------------
# Le service MySQL s'appelle `db` : ne mettez PAS 127.0.0.1 ici,
# car depuis le conteneur de l'API cela désignerait le conteneur lui-même.
MYSQL_DATABASE=wasomi
MYSQL_USER=wasomi
MYSQL_PASSWORD=CHANGE_ME_mysql_password

# Mot de passe root MySQL (utile pour l'administration).
MYSQL_ROOT_PASSWORD=CHANGE_ME_mysql_root_password

# ---------------------------------------------------------------------------
# SÉCURITÉ JWT — OBLIGATOIRE, sinon le conteneur refuse de démarrer
# ---------------------------------------------------------------------------
# 3 valeurs distinctes, 32 caractères minimum.
#   openssl rand -hex 32
ACCESS_TOKEN_SECRET=CHANGE_ME_access_token_secret_min_32_chars
REFRESH_TOKEN_SECRET=CHANGE_ME_refresh_token_secret_min_32_chars
CSRF_SECRET=CHANGE_ME_csrf_secret_min_32_chars

ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d

# ---------------------------------------------------------------------------
# COOKIES / CORS
# ---------------------------------------------------------------------------
# true  -> cookies Secure + SameSite=None  (requis seulement si le front est
#          sur un AUTRE domaine que l'API ; donc en général FALSE)
# false -> SameSite=lax, suffisant car Caddy sert le front ET l'API sur le
#          même domaine.
# En production derrière HTTPS avec un seul domaine : false.
COOKIE_SECURE=false

# Laissez vide sauf si vous servez l'API sur un sous-domaine dédié.
COOKIE_DOMAIN=

# Origines autorisées par CORS. Inutile en same-origin, utile pour le debug.
FRONTEND_ORIGINS=https://localhost

# ---------------------------------------------------------------------------
# COMPTE ADMINISTRATEUR
# ---------------------------------------------------------------------------
# Mettez RUN_SEED=true pour le PREMIER démarrage uniquement : cela crée les
# rôles, les permissions et ce compte. Remettez false ensuite.
RUN_SEED=true

BOOTSTRAP_ADMIN_EMAIL=admin@wasomi.cd
BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_strong_admin_password
BOOTSTRAP_ADMIN_NAME=Administrateur Wasomi